<Project>

  <!-- scripts/pack-local.ps1 writes this file while PulseSharp is not yet on nuget.org -->
  <Import Project=".local-feed/version.props" Condition="Exists('.local-feed/version.props')" />

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <PulseSharpVersion Condition="'$(PulseSharpVersion)' == ''">0.7.0-alpha</PulseSharpVersion>
  </PropertyGroup>

  <ItemGroup Label="PulseSharp">
    <PackageVersion Include="PulseSharp" Version="$(PulseSharpVersion)" />
    <PackageVersion Include="PulseSharp.Abstractions" Version="$(PulseSharpVersion)" />
    <PackageVersion Include="PulseSharp.Sqlite" Version="$(PulseSharpVersion)" />
    <PackageVersion Include="PulseSharp.PostgreSql" Version="$(PulseSharpVersion)" />
    <PackageVersion Include="PulseSharp.Sync" Version="$(PulseSharpVersion)" />
    <PackageVersion Include="PulseSharp.Sync.Server" Version="$(PulseSharpVersion)" />
    <PackageVersion Include="PulseSharp.Testing" Version="$(PulseSharpVersion)" />
  </ItemGroup>

  <ItemGroup Label="Desktop">
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

</Project>
