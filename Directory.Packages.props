<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <PulseSharpVersion>0.7.0-alpha</PulseSharpVersion>
  </PropertyGroup>

  <ItemGroup Label="PulseSharp">
    <PackageVersion Include="PulseSharp" Version="$(PulseSharpVersion)" />
    <PackageVersion Include="PulseSharp.Abstractions" Version="$(PulseSharpVersion)" />
    <PackageVersion Include="PulseSharp.Sqlite" Version="$(PulseSharpVersion)" />
    <PackageVersion Include="PulseSharp.PostgreSql" Version="$(PulseSharpVersion)" />
    <PackageVersion Include="PulseSharp.Sync" Version="$(PulseSharpVersion)" />
    <PackageVersion Include="PulseSharp.Sync.Server" Version="$(PulseSharpVersion)" />
    <PackageVersion Include="PulseSharp.Testing" Version="$(PulseSharpVersion)" />
  </ItemGroup>

  <ItemGroup Label="Desktop">
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
  </ItemGroup>

</Project>
