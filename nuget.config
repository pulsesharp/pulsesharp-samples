<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Until PulseSharp 0.6.0-alpha is on nuget.org: packages made by scripts/pack-local.ps1 -->
    <add key="local" value=".local-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="PulseSharp" />
      <package pattern="PulseSharp.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
